    "@upstash/redis": "^1.28.4",
    "compression": "^1.7.4",
    "errorhandler": "^1.5.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "htm": "^3.1.1",
    "jose": "^6.2.17",
    "morgan": "^1.10.0",
    "nocache": "4.0.0",
    "preact": "^11.2.0",
    "winston": "^3.13.0",
    "winston-dev-format": "^0.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.56.0",
    "longjohn": "^0.2.12",
    "nodemon": "^2.0.4",
    "postcss": "^8.5.6",
    "rollup": "^4.9.4",
